<Window x:Class="FactixPrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factix"
        Width="920"
        Height="640"
        MinWidth="760"
        MinHeight="480">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Factix" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="FolderText" Margin="0,4,0,14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Actualizar" Click="Refresh_Click" />
                <Button Content="Abrir archivo…" Click="OpenFile_Click" />
                <Button Content="Factura de ejemplo" Click="OpenSample_Click" />
                <Button Content="Instalar impresora" Style="{StaticResource AccentButton}" Click="Install_Click" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"
                   Text="Imprime cualquier documento a la impresora Factix. El trabajo aparece aquí para extraer la factura, corregirla y generar el PDF." />
        <ListView x:Name="JobsList" MouseDoubleClick="JobsList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Documento" Width="340" DisplayMemberBinding="{Binding DocumentName}" />
                    <GridViewColumn Header="Recibido" Width="180" DisplayMemberBinding="{Binding Received}" />
                    <GridViewColumn Header="Estado" Width="160" DisplayMemberBinding="{Binding Status}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
